;--------------------------------------------------------------------
;Quick Notes
;--------------------------------------------------------------------
:*:xcopy::
SendInput `
(
Email copy updated.
)
Return

:*:xjob::
StringReplace, clipboard, clipboard, `n, , All
StringReplace, clipboard, clipboard, `r, , All
StringReplace, clipboard, clipboard, Offer ID:%A_Space%, , All
StringReplace, clipboard, clipboard, Offer Description:%A_Space%", %A_Space%", All
StringReplace, clipboard, clipboard, Offer%A_Space%, `rOffer%A_Space%, All
StringReplace, clipboard, clipboard, All records, `rAll records, All
SendInput `
(
Job offer updated, Offer ID: ^v
)
Return

:*:xmvs::
SendInput, Variable Setup for: %ShortkeyMVS%{ENTER}Variables loaded:{SPACE}
Return

:*:xw1::
SendInput, W1 Dropped & Approved
Return

 
:*:xscreen::
StringReplace, clipboard, clipboard, `n, , All
StringReplace, clipboard, clipboard, `r, , All
StringReplace, clipboard, clipboard, CenControl ID:%A_Space%, , All
StringReplace, clipboard, clipboard, CenControl Description:%A_Space%", %A_Space%", All
StringReplace, clipboard, clipboard, CenControl, `rCenControl, All
StringReplace, clipboard, clipboard, All records, `rAll records, All
SendInput `
(
SCREENER PROGRAMMED: ^v
QM set for:{SPACE}%AutoQuota%
)
Return




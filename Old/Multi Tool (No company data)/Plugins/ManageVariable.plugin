;--------------------------------------------------------------------
;Variable Setup - Complete Options for All
;--------------------------------------------------------------------
VarSetup:
Gui, 1:Submit
PrimaryUIState = 0
ClipHoldForMVS := ClipboardAll
VariableSetupAdd = %VariableSetupChosen%
VariableSetupSubmitPromote = %VariableSetupChosen%
VariableSetupBlankChar = ; Blank character test.
MVSComma = ,
; ---- Create auto-input of activated variable names for xMVS shortkey
	ShortkeyMVS = %VariableSetupChosen%
	StringReplace, ShortkeyMVS, ShortkeyMVS, Session Variables, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, Session, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, Personal (PII), , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, Member Fact Variables, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, Custom Lookup, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, >, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, |, %MVSComma%, All
	StringReplace, ShortkeyMVS, ShortkeyMVS, ___________________, , All
	ShortkeyMVS = %ShortkeyMVS%*
	StringReplace, ShortkeyMVS, ShortkeyMVS, %MVSComma%*, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, *, , All
	StringReplace, ShortkeyMVS, ShortkeyMVS, %MVSComma%, %MVSComma%%A_Space%, All
; ---- Find and Replace variable names with code for ADD TO MODEL OFFICE

; ---- Search Gooogle
MTB4:
Gui, 1:Submit
	PrimaryUIState = 0
	StringReplace, AdvancedQuery, AdvancedQuery, %A_Space%, +, All
	Run, https://www.google.com/search?q=%AdvancedQuery%
Return

; ---- Search Google Images
MTB5:
Gui, 1:Submit
PrimaryUIState = 0
StringReplace, AdvancedQuery, AdvancedQuery, %A_Space%, +, All
Run, https://www.google.com/search?tbm=isch&q=%AdvancedQuery%
Return

; ---- Search IxQuick
MTB6:
Gui, 1:Submit
PrimaryUIState = 0
StringReplace, AdvancedQuery, AdvancedQuery, %A_Space%, +, All
Run, https://ixquick.com/do/search?query=%AdvancedQuery%&cat=web&pl=ie&language=english
Return

; ---- Submit Log Entry
MTB3:
Gui, 1:Submit
PrimaryUIState = 0
FileAppend,
(

%A_MM%/%A_DD%/%A_YYYY%,%A_Hour%:%A_Min%,%A_Username%,%LogLabel%,%AdvancedQuery%
), %UserSettingsDir%\Personal Log.csv
IfNotInString, AvailableLogTypes, %LogLabel%
	{
		IfNotInString, AvailableLogTypes, |
			{
				IniWrite, %LogLabel%|, %UserSettingsIni%, LogCustomization, LogTypes
				Return
			}
		IfInString, AvailableLogTypes, |
			{
				IniWrite, %AvailableLogTypes%%LogLabel%|, %UserSettingsIni%, LogCustomization, LogTypes
				Return
			}
	}
Return

; ---- Open Personal Log in Excel
MTB8:
Gui, 1:Submit
PrimaryUIState = 0
Run, excel.exe "%UserSettingsDir%\Personal Log.csv"
Return

MTB1:
Return


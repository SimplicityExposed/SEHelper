CNHelp:
IfEqual, EnableDevContent, 0
	{
	WinGetPos, PositionX, PositionY, , , Production Multi-Tool [V%MVersion% by Michael A. Smith]
	}
IfEqual, EnableDevContent, 1
	{
		WinGetPos, PositionX, PositionY, , , Production Multi-Tool [V%MVersion% by Michael A. Smith] [Developer Mode]
	}
WindowPosition = x%PositionX% y%PositionY%
Return

^RButton Up::Menu, ClipnoteMenu, Show ; Menu is defined in startup actions plugin.

ClearAllClipnotes:
CN1JC = ;
CN1Clip = ;
CN2JC = ;
CN2Clip = ;
CN3JC = ;
CN3Clip = ;
CN4JC = ;
CN4Clip = ;
Return

ClearCN1:

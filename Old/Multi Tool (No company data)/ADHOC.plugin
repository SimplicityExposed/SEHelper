^F7::
$stop := 0
Loop, 
{ 
	Send, {!}clear 5000{ENTER}
	Sleep, 45000
	if ($stop)
	{ 
	  return
	}
}

^F8:: $stop := 1

Return


;≜ - Lieutenant
;︽ - Sergeant
;︿ - Operator

:*:xbugreport::
TempClip("save")
Clipboard = `
(
Impact on game:%A_Space%
Version Found: 2.01.03
Frequency:%A_Space%
Time and date of issue: %A_DD%/%A_MM%/%A_YYYY%, %A_Hour%:%A_Min% CST 
Commander name: Arsen Cross
Description: %A_Space%
)
SendInput, {LControl Down}v{LControl Up}
TempClip("retrieve")
Return

:*:xstfu::
SendInput, https://youtu.be/xBFeR93m-H8
Return

^+F1::
WinSet, Style, -0xC00000,a ; remove the titlebar and border(s) 
WinMove, a, , -1, -1, 1920, 1080 ; move the window to 0,0 and reize it to 1920x1080
return

TempClip(action)
{
global TempClipData

IfEqual, action, save
	{
		Sleep, 100
		TempClipData := Clipboard
		return
	}
IfEqual, action, retrieve
	{
		Sleep, 100
		Clipboard := TempClipData
		Return
	}
return
}
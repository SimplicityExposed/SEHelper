	MakePluginSet:
	InputBox, FileSetName, Plugin Name, What do you want to name the plugin?
	If ErrorLevel
		Return
	else
		InputBox, FileSetFolder, Folder Selection, What Sub Folder do you want to put the file set in?`n`nLeave blank to put in root plugins folder., , , , , , , , Production\
	if ErrorLevel
		Return
	else
		FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.core
	FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.call
	FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.ui
	FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.ini
	FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.init
	FileAppend, , I:\CS\ProdMgmt\masmith\.Department - Production\.Project Resources\AHK Macro Development\Development\Multi-Tool Reorganized\Plugins\%FileSetFolder%%FileSetName%.tab
	Return
	

	WinActivate, , Internet Explorer
	Clipboard = http://internal.e-rewards.com/variablesubstitution/assignvars.jsp?job=%JobClip%&env=MODEL_OFFICE&addvariables=100&type=2&add=Add+Variable
	SendInput, {Alt Down}d{Alt Up}{Ctrl Down}v{Ctrl Up}{enter}
	Sleep, 1000
	WinActivate, , Internet Explorer
	Clipboard = http://internal.e-rewards.com/variablesubstitution/assignvars.jsp?job=%JobClip%&env=MODEL_OFFICE&variables=100&type100=2&email100=Y&micro100=Y&submit=Submit+Changes
	SendInput, {Alt Down}d{Alt Up}{Ctrl Down}v{Ctrl Up}{enter}
	Sleep, 1000
	WinActivate, , Internet Explorer
	Clipboard = http://internal.e-rewards.com/variablesubstitution/assignvars.jsp?job=%JobClip%&env=MODEL_OFFICE&variables=100&type100=2&email100=Y&micro100=Y&promote=Promote+Variables
	SendInput, {Alt Down}d{Alt Up}{Ctrl Down}v{Ctrl Up}{enter}
	IELoad(wb)
	Goto, LightTouchCycle
	Return
	
	
	
	
	
	
	
	
	
	
	
	
	JobInventoryCycle:
	IfEqual, StopInventory, 1
	{
		MsgBox, STOP COMMAND RECEIVED - %A_Hour%:%A_Min% CST
		Return
	}
	IfInString, Clipboard, STOP
	{
		MsgBox, END OF JOBS - %A_Hour%:%A_Min% CST
		Return
	}
	IfEqual, JobInventoryCycle, 0
	{
		JobInventoryCycle = 1
		Goto, JobInventoryGetandClone
		Return
	}
	IfEqual, JobInventoryCycle, 1
	{
		JobInventoryCycle = 2
		Goto, UpdateInventoryOffer
		Return
	}
	IfEqual, JobInventoryCycle, 2
	{
		JobInventoryCycle = 3
		Goto, SubmitJobInventory
		Return
	}
	IfEqual, JobInventoryCycle, 3
	{
		JobInventoryCycle = 0
		Goto, PromoteJobInventory
		Return
	}
	JobInventoryCycle = 0
	Goto, JobInventoryCycle
	Return
	
	JobInventoryGetandClone:
	; RETRIEVE NEXT JOB NUMBER
	Clipboard = ;
	WinActivate, Job Inventory Creation.xlsx - Excel
	SendInput, {Down}
	SendInput, ^c
	Clipwait
	IfInString, Clipboard, STOP
	{
		MsgBox, END OF JOBS - %A_Hour%:%A_Min% CST
		Return
	}
	JobClip = %Clipboard%
	StringReplace, JobClip, JobClip, `r, , All
	StringReplace, JobClip, JobClip, `n, , All
	StringReplace, JobClip, JobClip, %A_Tab%, , All
	Clipboard = ;
	; CLONE JOB OFFER
	WinActivate, , Internet Explorer
	CloneOfferID = 505864
	sendInput, {Alt Down}d{Alt Up}
	Clipboard = http://internal.e-rewards.com/surveymgmt/CloneOffer?database=2&offer=%CloneOfferID%&languageLocale_2=EN_US&languageLocale_1=EN_AU
	SendInput, ^v
	SendInput, {ENTER}
	IELoad(wb)
	Goto, JobInventoryCycle
	Return
	
	UpdateInventoryOffer:
	WinActivate, , Internet Explorer
	SendInput, {Alt Down}d{Alt Up}
	SendInput, {TAB 6}
	SendInput, TBD: Job Inventory [010301 Q2S]
	Clipboard = %JobClip%
	SendInput, {TAB 6}
	SendInput, ^v
	SendInput, {TAB 2}
	SendInput, {ENTER}
	IELoad(wb)
	Soundbeep
	Goto, JobInventoryCycle
	Return
	
	SubmitJobInventory:
	WinActivate, , Internet Explorer
	SendInput, {Alt Down}d{Alt Up}
	SendInput, {TAB 16}
	SendInput, {ENTER}
	IELoad(wb)
	Soundbeep
	Goto, JobInventoryCycle
	Return
	Return
	
	PromoteJobInventory:
	WinActivate, , Internet Explorer
	SendInput, {Alt Down}d{Alt Up}
	SendInput, {TAB 7}
	SendInput, {ENTER}
	IELoad(wb)
	Soundbeep
	Goto, JobInventoryCycle
	Return
	

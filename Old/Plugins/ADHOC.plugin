	CommaDelimitedClip:
	CommaDelimitedCommaIs = ,
	StringReplace, Clipboard, Clipboard, `r`n, |, All
	StringReplace, Clipboard, Clipboard, `n, |, All
	StringReplace, Clipboard, Clipboard, `r, |, All
	StringReplace, Clipboard, Clipboard, %A_Space%, |, All
	StringReplace, Clipboard, Clipboard, %A_Tab%, |, All
	CommaDelimitedClipRecheck:
	IfInString, Clipboard, ||
	{
		StringReplace, Clipboard, Clipboard, ||, |, All
		Goto, CommaDelimitedClipRecheck
	}
	MsgBox, Clipboard Cleaned paste it!	
	Return
	
	ClipFormatTest:
	StringReplace, Clipboard, Clipboard, `r`n, |, All ; `%0D`%0A
	RecheckDuplicateDelimeter:
	IfInString, Clipboard, ||
	{
		StringReplace, Clipboard, Clipboard, ||, |, All
		Goto, RecheckDuplicateDelimeter
	}
	StringReplace, Clipboard, Clipboard, | , `r`n, All
	;Clipboard = %Clipboard%&seedLevel=1&submit=Get+Results
	;IfInString, Clipboard, |&seedLevel
	{
		StringReplace, Clipboard, Clipboard, |&seedLevel, &seedLevel, All
	}
	;StringReplace, Clipboard, Clipboard, |, `%0D`%0A, All ; `%0D`%0A
	MsgBox, Clipboard Cleaned paste it!
	Return
	
